# .env.example — Template for .env (this file IS committed to git).
# Copy to .env and fill in your values:
#   cp .env.example .env

# Apple iCloud CalDAV
# Generate an app-specific password at: https://appleid.apple.com → Security → App-Specific Passwords
APPLE_CALDAV_URL=https://caldav.icloud.com/
APPLE_USERNAME=your.apple.id@icloud.com
APPLE_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Google Calendar (OAuth2 — only needed if calendar_provider = "google" in user_settings.json)
# credentials.json goes in credentials/ (see docs for Google Calendar setup)
GOOGLE_CALENDAR_ID=primary

# HuggingFace (only needed for cluster evaluation — eval/cluster_work/run_eval_hf.py)
# Generate a token at: https://huggingface.co/settings/tokens
HF_DATASET=org/dataset-name
HF_TOKEN=hf_your_token_here
